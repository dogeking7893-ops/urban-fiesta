    HopBtn.Text = "..."

    task.spawn(function()
        local success, result = pcall(function()
            local url = string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
                game.PlaceId
            )

            local raw = game:HttpGet(url)
            local data = game:GetService("HttpService"):JSONDecode(raw)

            if not data or not data.data then return nil end

            local candidates = {}
            for _, srv in ipairs(data.data) do
                if srv.id ~= game.JobId
                and srv.playing < srv.maxPlayers
                and srv.playing > 0 then
                    table.insert(candidates, srv.id)
                end
            end

            if #candidates == 0 then return nil end
            return candidates[math.random(1, #candidates)]
        end)

        if success and result then
            pcall(function()
                game:GetService("TeleportService"):TeleportToPlaceInstance(
                    game.PlaceId,
                    result,
                    Player
                )
            end)
        else
            HopBtn.Text = "FAIL"
            HopStatus.Text = "Couldn't find a server"
            HopStatus.Text = C.Red and "Couldn't find a server" or "Couldn't find a server"
            HopStatus.TextColor3 = C.Red
            task.wait(2)
            HopBtn.Text = "HOP"
            HopStatus.Text = "Jump to a random server"
            HopStatus.TextColor3 = C.Gray
        end
    end)
end)

