function removeTPTool()
    local char = Player.Character
    if not char then return end

    local tool = char:FindFirstChild("PERFECT_TP_TOOL")
    if tool then tool:Destroy() end

    local pack = Player:FindFirstChildOfClass("Backpack")
    if pack then
        local t2 = pack:FindFirstChild("PERFECT_TP_TOOL")
        if t2 then t2:Destroy() end
    end
end

function giveTPTool()
    removeTPTool()

    local char = Player.Character
    if not char then return end

    local tool = Instance.new("Tool")
    tool.Name = "PERFECT_TP_TOOL"
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.ToolTip = "Tap anywhere to teleport"

    tool.Activated:Connect(function()
        local mouse = Player:GetMouse()
        if not mouse or not mouse.Hit then return end

        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
        end
    end)

    tool.Parent = char
end

TPToolBtn.MouseButton1Click:Connect(function()
