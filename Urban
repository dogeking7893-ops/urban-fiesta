            if FPSAccumulatedTime >= 0.5 then

                local FPS =
                    FPSFrameCount /
                    FPSAccumulatedTime

                FPS = math.clamp(
                    FPS,
                    0,
                    240
                )

                CurrentFPS = FPS

                FPSLabel.Text =
                    string.format(
                        "FPS: %.0f",
                        FPS
                    )

                AddGraphPoint(
                    FPSGraph,
                    FPSPoints,
                    FPS,
                    120
                )

                if FPS <= 10 then

                    if not FPSAlertActive then

                        FPSAlertActive = true

                        ShowNotification(
                            "LOW FPS",
                            string.format(
                                "Performance dropped to %.0f FPS",
                                FPS
                            ),
                            C.Violet
                        )
                    end

                else

                    FPSAlertActive = false
                end

                FPSFrameCount = 0
                FPSAccumulatedTime = 0
            end
        end
