--========================================================
-- CREATE HELPER OVERRIDE
--========================================================

Create = function(class, props, parent)
    local obj = Instance.new(class)

    for key, value in pairs(props or {}) do
        if key ~= "Parent" then
            obj[key] = value
        end
    end

    obj.Parent = parent or props.Parent

    return obj
end

