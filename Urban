        if Old then
            Old:Destroy()
        end

    end

    local Width = Graph.AbsoluteSize.X

    if Width > 0 then

        for Index, Existing in ipairs(Points) do

            local X =
                ((Index - 1) / 27) * Width

            Existing.Position =
                UDim2.new(
                    0,
                    X,
                    Existing.Position.Y.Scale,
                    Existing.Position.Y.Offset
                )

