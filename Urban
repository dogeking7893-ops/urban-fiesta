        AimUIStatus.Text = "● INSTANT LOCKED: " .. SelectedTargetPlayer.Name
        AimUIStatus.TextColor3 = C.Green

        local currentCFrame = Camera.CFrame
        local targetCFrame = CFrame.new(currentCFrame.Position, targetPart.Position)
        Camera.CFrame = currentCFrame:Lerp(targetCFrame, 1.0)
    else
        AimUIStatus.Text = "● TARGET IS DEAD OR MISSING"
        AimUIStatus.TextColor3 = C.Red
    end
end)

