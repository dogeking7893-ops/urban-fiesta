-- OPENER DRAGGING
--========================================================

draggingOpener = false
dragStart = nil
openerStart = nil

DragHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        draggingOpener = true
        dragStart = input.Position
        openerStart = Opener.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if not draggingOpener then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        local newPosition = UDim2.new(
            openerStart.X.Scale,
            openerStart.X.Offset + delta.X,
            openerStart.Y.Scale,
            openerStart.Y.Offset + delta.Y
        )
        Opener.Position = newPosition
        OpenerGlow.Position = UDim2.new(
            newPosition.X.Scale,
            newPosition.X.Offset,
            newPosition.Y.Scale,
            newPosition.Y.Offset - 4
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        draggingOpener = false
    end
end)

