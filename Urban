function AnimateGradient(Object)

    for _, Item in ipairs(Object:GetDescendants()) do

        if Item:IsA("UIGradient") then

            local OriginalRotation = Item.Rotation

            TweenService:Create(
                Item,
                TweenInfo.new(
                    5,
                    Enum.EasingStyle.Sine,
                    Enum.EasingDirection.InOut,
                    -1,
                    true
                ),
                {
                    Rotation = OriginalRotation + 35
                }
            ):Play()
        end
    end
end

